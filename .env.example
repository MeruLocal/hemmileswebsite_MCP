# ---------------------------------------------------------------------------
# Hemmiles MCP Server — configuration (all variables are OPTIONAL)
#
# The server talks only to the public Hemmiles website over HTTPS. It needs no
# API keys, secrets, or credentials. The variables below only tune behavior.
# Copy this file to `.env` to override defaults (the server also reads plain
# process environment variables; it does not auto-load .env unless your runner
# does — see README).
# ---------------------------------------------------------------------------

# Transport: "stdio" (default, for Claude Desktop) or "http" (Streamable HTTP).
HEMMILES_TRANSPORT=stdio

# Port for the HTTP transport (ignored for stdio).
PORT=3000

# Default market/locale used when a tool call omits one.
# One of: global, in, us, gb, ca, au, nz, ie, sg, ae, za
HEMMILES_DEFAULT_LOCALE=in

# Per-request timeout in milliseconds (1000–60000).
HEMMILES_TIMEOUT_MS=20000

# Max retry attempts for transient network/5xx/429 errors (0–5).
HEMMILES_MAX_RETRIES=3

# Minimum spacing between outbound requests in ms (conservative rate limiting).
HEMMILES_MIN_REQUEST_INTERVAL_MS=600

# In-memory cache TTL for fetched pages/sitemaps in seconds (0 disables caching).
HEMMILES_CACHE_TTL_SECONDS=300

# User-Agent sent with every request. Identify your client honestly.
HEMMILES_USER_AGENT=hemmiles-mcp-server/1.0 (+https://github.com/your-org/hemmiles-mcp-server)

# --- HTTP transport only -----------------------------------------------------
# Listen address. Unset = all interfaces (the Docker image sets 0.0.0.0).
# HOST=127.0.0.1

# Host header allowlist (hostname only; the port is ignored). Requests to /mcp
# with any other Host get 403 (DNS-rebinding protection).
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],::1,mcp.hemmiles.com

# Browser Origin allowlist. Loopback origins on any port are always allowed;
# requests without an Origin header (agents, curl) are allowed.
MCP_ALLOWED_ORIGINS=https://mcp.hemmiles.com

# POST /mcp requests per client IP per minute (0 = off).
MCP_RATE_LIMIT_PER_MINUTE=60

# 1 = take the client IP from the right-most X-Forwarded-For hop. Behind a CDN
# that hop may be an edge IP shared by many clients; leave unset unless the
# proxy in front sets the real client IP.
# TRUST_PROXY=1
