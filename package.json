{
  "name": "hemmiles-mcp-server",
  "version": "1.0.0",
  "description": "The official MCP server for Hemmiles (hemmiles.com) field-visit SaaS: read-only access to search, pages, features, pricing, resources, FAQs and company info for MCP clients such as Claude Desktop.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hemmiles-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage tests/*.test.ts",
    "inspector": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "check:versions": "node scripts/check-versions.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hemmiles",
    "claude",
    "field-visit",
    "field-sales"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeruLocal/hemmileswebsite_MCP.git"
  },
  "homepage": "https://hemmiles.com",
  "bugs": {
    "url": "https://github.com/MeruLocal/hemmileswebsite_MCP/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cheerio": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
